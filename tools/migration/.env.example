# Source and target credentials stay in private libpq files outside this repository.
# Use a direct connection or session pooler; do not use transaction pooling.
PGSERVICEFILE=
PGPASSFILE=
NIGHTOWL_SOURCE_SERVICE=
NIGHTOWL_TARGET_SERVICE=
# Required exact target database name, independent of the service alias.
NIGHTOWL_TARGET_DATABASE=
# Source project URL only, e.g. https://PROJECT.supabase.co (no key/query/path).
NIGHTOWL_SUPABASE_URL=
# File containing the service-role key; chmod 600, outside this repository.
NIGHTOWL_STORAGE_KEY_FILE=
# Choose a private backup folder outside this repository.
NIGHTOWL_EXPORT_DIR=
