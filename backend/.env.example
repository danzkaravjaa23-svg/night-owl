# Copy to backend/.env. This example cannot authorize a production cutover.
# Keep real values and files outside Git. Never put a service-role key in Flutter.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8787
APP_WEB_ORIGIN=

# Absolute paths on the deployment host. No secret files are supplied.
# Host ownership/private ACLs must match each actual container reader UID/GID.
# Run preflight_secrets.py on the deployment host; do not use world-readable
# permissions or rely on Compose uid/gid overrides for file-backed secrets.
POSTGRES_PASSWORD_PATH=
AUTHENTICATOR_PASSWORD_PATH=
READINESS_PASSWORD_PATH=
POSTGREST_DB_URI_PATH=
JWT_VERIFICATION_KEY_PATH=

# Required compatible service ORIGINS, without credentials, path or query.
# Each upstream must support the existing full /auth/v1, /storage/v1 or
# /realtime/v1 client path. Provider adapters are not implemented here.
AUTH_UPSTREAM=
STORAGE_UPSTREAM=
REALTIME_UPSTREAM=

# Required unauthenticated health paths on those chosen origins.
AUTH_READY_PATH=
STORAGE_READY_PATH=
REALTIME_READY_PATH=

# Explicit release gates after restore, ACL review and real integration tests.
# Merely setting URLs or restoring a database does not complete migration.
UPSTREAM_PROTOCOL_VERIFIED=false
CUTOVER_APPROVED=false
